# Solana Sniper Pro - Environment Variables Template

# Kopiere diese Datei als .env und fülle die Werte aus
# WICHTIG: .env niemals committen oder teilen!

# ===========================================
# SOLANA KONFIGURATION
# ===========================================

# Dein Solana Private Key (Base58-encoded)
# NIEMALS diesen Key mit anderen teilen!
SOLANA_PRIVATE_KEY=your_private_key_here

# RPC Endpoint (empfohlen: Helius, Triton, Quicknode)
# Öffentlicher RPC: https://api.mainnet-beta.solana.com
SOLANA_RPC_ENDPOINT=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY

# Commitment Level: 'processed', 'confirmed', oder 'finalized'
SOLANA_COMMITMENT=confirmed

# ===========================================
# TRADING KONFIGURATION
# ===========================================

# Minimale Wallet-Balance in SOL bevor gewarnt wird
MIN_BALANCE=0.1

# Standard Trading-Strategie: 'konservativ', 'aggressiv', 'jackpot'
DEFAULT_STRATEGY=konservativ

# Maximale Positionen gleichzeitig (wird von Strategie überschrieben)
MAX_POSITIONS=6

# ===========================================
# SICHERHEITSKONFIGURATION
# ===========================================

# Top Holder Konzentrations-Limits (%)
BLOCK_TOP_HOLDER_PERCENT=60  # Blockieren wenn Top 10 > X%
WARN_TOP_HOLDER_PERCENT=40   # Warnen wenn Top 10 > X%

# Minimale LP-Lock-Dauer in Tagen
MIN_LP_LOCK_DAYS=30

# Honeypot-Schutz aktivieren
ENABLE_HONEYPOT_CHECK=true

# ===========================================
# TELEGRAM KONFIGURATION (Optional - Phase 2)
# ===========================================

# Telegram API Credentials für Bot
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token

# Admin User IDs die den Bot steuern können
TELEGRAM_ADMIN_IDS=user1,user2,user3

# ===========================================
# MONITORING KONFIGURATION (Optional)
# ===========================================

# Healthcheck.io URL für Uptime-Monitoring
HEALTHCHECK_URL=https://hc-ping.com/your-uuid-here

# Discord Webhook für Benachrichtigungen
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK

# ===========================================
# JITO KONFIGURATION (Optional - Phase 3)
# ===========================================

# Jito Auth Keypair für Bundle-Submission
JITO_AUTH_KEYPAIR=/path/to/jito_keypair.json

# Jito Tipp in SOL (0.001 - 0.01 empfohlen)
JITO_TIP_AMOUNT=0.005

# ===========================================
# DATENBANK KONFIGURATION
# ===========================================

# Datenbank-URL (SQLite standardmäßig)
DATABASE_URL=sqlite:///data/bot.db

# Redis für Caching (optional)
REDIS_URL=redis://localhost:6379/0

# ===========================================
# LOGGING KONFIGURATION
# ===========================================

# Log-Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log-Datei Pfad
LOG_FILE=logs/bot.log

# Maximale Log-Dateigröße in MB
LOG_MAX_SIZE=10

# Anzahl zu behaltender Log-Files
LOG_BACKUP_COUNT=5

# ===========================================
# ADVANCED KONFIGURATION
# ===========================================

# Rate Limiting (Requests pro Sekunde)
RPC_RATE_LIMIT=10

# Timeout für RPC Requests in Sekunden
RPC_TIMEOUT=10

# Auto-Restart bei Crash
AUTO_RESTART=true

# Test-Modus (kein echtes Trading)
TEST_MODE=false

# Dry-Run Modus (simuliert Trades ohne Ausführung)
DRY_RUN=false
